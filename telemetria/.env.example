# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=telemetria
DB_USER=root
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=3306

# MQTT Configuration
MQTT_HOST=your-cloudamqp-host.rmq.cloudamqp.com
MQTT_PORT=1883
MQTT_TOPIC=dadosSensor
MQTT_CLIENT_ID=django-worker
MQTT_USERNAME=your-username:your-username
MQTT_PASSWORD=your-password-here

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
